#!/usr/bin/env bash

session=$(find -L ~ ~/Documents ~/Documents/Proyectos/ -mindepth 1 -maxdepth 1 -type d | fzf)

if [[ -z $session ]]; then
  exit 0
fi

session_name=$(basename "$session" | tr . _)
tmux_running=$(pgrep tmux)

if tmux has-session -t=$session_name 2>/dev/null; then
  if [[ -z $TMUX ]]; then
    tmux attach-session -t $session_name
  else
    tmux switch-client -t $session_name
  fi
  exit 0
fi

if ! tmux has-session -t="$session_name" 2>/dev/null; then
  tmux new-session -ds "$session_name" -c "$session"
fi

# If inside tmux, switch instead of attach to avoid nesting issues
if [[ -z $TMUX ]]; then
  tmux attach-session -t "$session_name"
else
  tmux switch-client -t "$session_name"
fi
